thirdparty/** linguist-vendored=true
* text=auto eol=native
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

.clangd filter=gitignore
rmp   text eol=lf

# The fuzz targets' inputs are bytes, not text: a Windows checkout must not
# turn an LF into CRLF and replay a different input (tools/fuzz.sh).
tests/fuzz/corpus/** -text
tests/fuzz/regressions/** -text
