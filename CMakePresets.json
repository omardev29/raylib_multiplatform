{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PRODUCTION_BUILD": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PRODUCTION_BUILD": "ON"
            }
        },
        {
            "name": "windows",
            "displayName": "Release, Windows x64 from Linux (MinGW-w64)",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/windows",
            "toolchainFile": "${sourceDir}/cmake/windows_cross.cmake"
        },
        {
            "name": "windows-clang-cl",
            "displayName": "Release, Windows x64 from Linux (clang-cl, Microsoft's runtime from xwin)",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/windows-clang-cl",
            "toolchainFile": "${sourceDir}/cmake/windows_clang_cl.cmake"
        },
        {
            "name": "debug-drm",
            "displayName": "Debug, DRM/KMS (a Linux console: no X11, no Wayland)",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/build/debug-drm",
            "cacheVariables": {
                "RMP_TARGET_DRM": "ON"
            }
        },
        {
            "name": "release-drm",
            "displayName": "Release, DRM/KMS (a Linux console: no X11, no Wayland)",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/release-drm",
            "cacheVariables": {
                "RMP_TARGET_DRM": "ON"
            }
        },
        {
            "name": "web",
            "displayName": "Web (Emscripten)",
            "inherits": "base",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "binaryDir": "${sourceDir}/build/web",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PRODUCTION_BUILD": "ON",
                "PLATFORM": "Web"
            }
        },
        {
            "name": "memory",
            "displayName": "Software render (no GPU, no window)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/memory",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PRODUCTION_BUILD": "OFF",
                "PLATFORM": "Memory"
            }
        },
        {
            "name": "lint",
            "displayName": "Compile database for clang-tidy (configure only)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/lint",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PRODUCTION_BUILD": "OFF",
                "BUILD_TESTS": "ON",
                "BUILD_UI_TESTS": "ON",
                "RMP_BUILD_EXAMPLES": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "windows",
            "configurePreset": "windows"
        },
        {
            "name": "windows-clang-cl",
            "configurePreset": "windows-clang-cl"
        },
        {
            "name": "debug-drm",
            "configurePreset": "debug-drm"
        },
        {
            "name": "release-drm",
            "configurePreset": "release-drm"
        },
        {
            "name": "web",
            "configurePreset": "web"
        },
        {
            "name": "memory",
            "configurePreset": "memory"
        }
    ]
}
