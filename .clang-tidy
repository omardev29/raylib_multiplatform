# .clang-tidy -- the checks that find bugs, the checks that hold the style
# guide, and none of the ones that only produce work.
#
#   rmp lint            check src/, tests/ and examples/ (and the headers they reach)
#   rmp lint fix        and apply the fixes it is sure about
#
# THE BUG FINDERS. A check earns its place by catching a real bug, not by being
# enabled by default somewhere. Every family below is here whole; every
# exclusion under it is a check that fights a decision this repository has
# already made, and each one says which.
#
# THE STYLE GUIDE. Omar's rules of 2026-10-10 are mandatory in the framework,
# its tests and the examples: const on everything that does not change,
# std::array, enum class, static_cast, no raw pointer, a macro only for what a
# function cannot do, and Google's guide wherever ours says nothing. Every one
# a compiler can see is a check here, named under "The style guide" below with
# the rule it stands for; tools/style_check.sh says the ones only text can
# (every #if branch, `++i`). What the tree still owes is tools/lint_debt.txt,
# one line per check and file, and that list only shrinks.
#
# tools/lint.sh configures the `lint` preset (build/lint, configure only) for
# the compile database it needs and passes --experimental-custom-checks --
# without it the CustomChecks below are not run, and nothing says so.
# examples/.clang-tidy narrows this file for the examples.

Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  misc-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-no-malloc,
  clang-diagnostic-shadow,

  cppcoreguidelines-use-enum-class,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-macro-usage,
  google-explicit-constructor,
  google-runtime-int,
  google-runtime-float,
  google-runtime-operator,
  google-default-arguments,
  google-build-using-namespace,
  google-build-namespaces,
  google-build-explicit-make-pair,
  google-global-names-in-headers,
  custom-*,

  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,

  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,

  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-macro-to-enum,
  -modernize-use-designated-initializers,

  -portability-avoid-pragma-once,
  -performance-enum-size,
  -readability-redundant-member-init,
  -readability-use-std-min-max,
  -readability-use-concise-preprocessor-directives,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -readability-function-cognitive-complexity,
  -readability-uppercase-literal-suffix,
  -readability-avoid-nested-conditional-operator,
  -readability-math-missing-parentheses,

# The style guide -- each check, and the rule it holds:
#
#   misc-const-correctness       const on every local that does not change,
#                                and on what a pointer points to when nothing
#                                writes through it. It was excluded for
#                                "never finding a bug"; the rule is not about
#                                bugs but about the reader, who learns at the
#                                declaration that the value at the bottom of
#                                the function is the one at the top. A
#                                by-value parameter is the same rule, in the
#                                definition only -- clang-tidy 22 does not
#                                look at parameters, and
#                                readability-avoid-const-params-in-decls keeps
#                                the const out of the declaration.
#   modernize-avoid-c-arrays     std::array, which knows its size and copies
#                                like a value. raylib takes C arrays, and
#                                std::array::data() at the call is the boundary.
#   modernize-avoid-c-style-cast static_cast says which conversion was meant
#                                (in modernize-*; tools/style_check.sh S1 reads
#                                the #if branches this cannot).
#   cppcoreguidelines-use-enum-class
#                                enum class: its members neither leak into the
#                                enclosing scope nor turn into int unasked.
#   cppcoreguidelines-special-member-functions
#                                a class that writes one of the five says what
#                                becomes of the other four. A lone `= default`
#                                destructor says nothing, and a class whose copy
#                                is deleted is not asked for its moves.
#   cppcoreguidelines-macro-usage
#                                a macro only for what a function cannot do: the
#                                call site, code generated at file scope, `#if`,
#                                a value from the .toml. Each macro of ours that
#                                is one is named in AllowedRegexp below; a new
#                                one is a review question, not a fix.
#   google-explicit-constructor  a one-argument constructor or a conversion is
#                                explicit. The conversions the API makes on
#                                purpose -- a Value from a number, a Sizing from
#                                a float -- carry a NOLINT with the reason.
#   google-runtime-int           int and <cstdint>'s fixed widths, never short,
#                                long or long long, whose size the platform picks.
#   google-runtime-float         float and double; never long double.
#   google-runtime-operator      no overloaded unary `&`.
#   google-default-arguments     no default argument on a virtual function.
#   google-build-using-namespace no `using namespace`.
#   google-build-namespaces      no anonymous namespace in a header.
#   google-build-explicit-make-pair
#                                std::make_pair deduces; spelt out, it breaks.
#   google-global-names-in-headers
#                                no using-declaration at global scope in a header.
#   custom-rmp-raw-pointer       no raw pointer -- CustomChecks, below.
#   custom-rmp-header-constant   a namespace-scope constant in a header is
#                                `inline constexpr` -- CustomChecks, below.
#
# Why each exclusion above:
#
#   bugprone-easily-swappable-parameters   every (float x, float y) in a 2D
#                                          framework, which is all of them.
#   bugprone-narrowing-conversions         float/int mixing is what raylib's own
#                                          API does; the analyzer catches the
#                                          cases that actually lose data.
#   misc-non-private-member-variables      the options structs and rmp::object
#                                          are public data BY DESIGN. Making
#                                          them private is the opposite of the
#                                          rule that outranks the others.
#   misc-no-recursion                      the layout walk is a tree walk.
#   misc-include-cleaner                   wants an #include for every raylib
#                                          symbol; raylib is one header.
#   misc-use-anonymous-namespace           `static` at file scope is the
#   misc-use-internal-linkage              deliberate spelling: main.cpp is the
#                                          file a newcomer reads first and it
#                                          has a plain-C twin in examples/, so
#                                          the two stay the same shape.
#   modernize-use-trailing-return-type     `auto f() -> int` is not the style.
#   modernize-use-nodiscard                would decorate the whole API for the
#                                          two call sites where it matters.
#   modernize-macro-to-enum                the generated RMP_* values are macros
#                                          on purpose: the C entry point uses
#                                          them too.
#   modernize-use-designated-initializers  suggests them inside our own
#                                          implementation, where the field order
#                                          is Clay's, not ours.
#   portability-avoid-pragma-once          #pragma once is the repository's
#                                          decision; every one of the fourteen
#                                          compilers supports it.
#   performance-enum-size                  pinning an underlying type on a
#                                          public enum is ABI churn for bytes
#                                          nobody is short of.
#   readability-redundant-member-init      `detail::sizing size{};` is redundant
#                                          and stays: in an options struct every
#                                          field shows its default, and one
#                                          field that does not is worse.
#   readability-use-std-min-max            the explicit `if (dt > 0.1f)` clamps
#                                          are written that way with a comment
#                                          saying why the bound is what it is.
#   readability-use-concise-preprocessor-directives
#                                          `#if defined(A) || defined(B)` and
#                                          `#if defined(A)` are written the same
#                                          way on purpose.
#   readability-identifier-length          `dt`, `t`, `o` are the vocabulary.
#   readability-magic-numbers              it is a game; 44 is a touch target.
#   readability-braces-around-statements   single-line guards are the style, and
#                                          .clang-format is set up to keep them.
#   readability-implicit-bool-conversion   raylib returns int for booleans.
#   readability-function-cognitive-complexity  a render switch is one function
#                                          on purpose.
#   readability-uppercase-literal-suffix   `1.0f`, not `1.0F`.
#
# Only our own code. thirdparty/ is frozen: a warning there is not actionable,
# and the vendored headers are the pin. generated/ is rewritten on every
# configure.
HeaderFilterRegex: '.*/(include/rmp|src/rmp|src/scenes|src/objects|tests)/.*'
#
# smoke_test.h is excluded on top of that, and not because it is exempt from
# review: it is compiled as C99 by examples/plain_c/main.c, so `(void)`
# parameter lists, C-style casts and NULL are REQUIRED there, and every
# modernize-* check has the opposite opinion.
ExcludeHeaderFilterRegex: '.*/(thirdparty|generated|build)/.*|.*/smoke_test\.h'

# Not errors to clang-tidy itself: tools/lint.sh counts every warning against
# tools/lint_debt.txt, and one that is not owed there fails `rmp lint` and the
# CI lint job alike -- as does a line there that owes more than is left.
WarningsAsErrors: ''
FormatStyle: file

# -Wshadow, through clang-tidy rather than the build: a local or a parameter
# that takes the name of a file-state group (`int pass` against the group
# `pass`) hides it, and the code that meant the group either fails to compile
# or, worse, compiles against the local.
ExtraArgs: ['-Wshadow']

# Two rules no clang-tidy check states, written as AST queries
# (https://clang.llvm.org/extra/clang-tidy/QueryBasedCustomChecks.html). They
# report as custom-<Name>. Experimental in clang-tidy 22: a bump of the pinned
# clang-tidy re-runs ClangTidyGuidelineTest, which sees each one fire. A
# regex in a query is read as written, with no C escaping: `"\\.h$"` is a
# backslash and any character, and matches nothing. A dot is `[.]`.
CustomChecks:
  # No raw pointer anywhere -- Omar's rule of 2026-10-10. What is held is a
  # value, a reference, std::span, std::optional, rmp::Ref or rmp::Handle; what
  # is owned is a value or a unique_ptr. A pointer asks its reader whether it
  # may be null, who owns it and how long it lives, and its type answers none.
  # Where it is allowed, and nowhere else:
  #   - a pointer to a type of the C libraries we speak to -- Clay, cJSON,
  #     cute_tiled, cute_aseprite, rres -- is their API, not our choice;
  #   - an `extern "C"` function's parameters: libFuzzer's ABI is a pointer;
  #   - operator->, which the language requires to return one;
  #   - a DECLARATION in include/rmp/, which tools/pointer_check.py reads (with
  #     its own ratchet); the bodies of its inline functions are read here;
  #   - C: tools/rres_pack.c, the plain C example and the sanitizer hooks are C
  #     because they must be, and C has nothing else to offer.
  # raylib is not on the list: its pointers are what our own code chooses to
  # declare (a Vector2 *out), and a char * is a C string either way.
  - Name: rmp-raw-pointer
    Query: |
      match declaratorDecl(
          anyOf(hasType(pointerType()), functionDecl(returns(pointerType()))),
          unless(isImplicit()),
          unless(isExpansionInFileMatching("[.]c$")),
          unless(cxxMethodDecl(hasOverloadedOperatorName("->"))),
          unless(hasType(pointerType(pointee(hasUnqualifiedDesugaredType(recordType(
              hasDeclaration(decl(isExpansionInFileMatching(
                  "thirdparty/(clay|cJSON|cute_tiled|cute_aseprite|rres)/"))))))))),
          unless(functionDecl(returns(pointerType(pointee(hasUnqualifiedDesugaredType(recordType(
              hasDeclaration(decl(isExpansionInFileMatching(
                  "thirdparty/(clay|cJSON|cute_tiled|cute_aseprite|rres)/")))))))))),
          unless(parmVarDecl(hasDeclContext(functionDecl(isExternC())))),
          unless(functionDecl(isExternC())),
          unless(allOf(isExpansionInFileMatching("include/rmp/"),
                       unless(hasAncestor(compoundStmt()))))).bind("pointer")
    Diagnostic:
      - BindName: pointer
        Level: Warning
        Message: "a raw pointer: a value, a reference, std::span, std::optional, std::string_view, rmp::Ref or rmp::Handle"

  # A constant at namespace scope in a header is `inline constexpr`: one object
  # for the whole program instead of a copy per translation unit (a `const` or
  # `constexpr` there is internal linkage), and known when it compiles.
  - Name: rmp-header-constant
    Query: |
      match varDecl(
          hasDeclContext(anyOf(namespaceDecl(), translationUnitDecl())),
          anyOf(isConstexpr(), hasType(isConstQualified())),
          unless(isInline()),
          isDefinition(),
          isExpansionInFileMatching("[.](h|hpp)$")).bind("constant")
    Diagnostic:
      - BindName: constant
        Level: Warning
        Message: "a constant in a header is `inline constexpr`: one object for the program, known when it compiles"

CheckOptions:
  # The naming rule, checked instead of remembered. CLAUDE.md, "Naming", has
  # the table and the reasons; this is the part a compiler can check.
  #
  #   Types (class, struct, enum, alias)   PascalCase      rmp::ui::ButtonOptions
  #   Enum members                         CONSTANT_CASE   rmp::ui::Align::TOP_LEFT
  #   Constants                            CONSTANT_CASE   MAX_LABELS
  #   Functions and methods                snake_case      rmp::ui::current_theme()
  #   Variables, parameters, public fields snake_case      min_height, delta
  #   Private and protected fields         _snake_case     _slot
  #   The eight hooks (methods)            _snake_case     _ready, _update
  #   Namespaces                           snake_case      rmp::ui::detail
  #   Macros                               RMP_CONSTANT    RMP_ENTRY_POINT
  #
  # tools/naming_check.sh says the rest, over every #if branch: no g_ or k
  # names, no underscore touching a dot, no constant named like somebody
  # else's macro, no retired name.
  #
  # What it buys: at any point of use you can tell a type from a value without
  # going to look. `Align::TOP_LEFT` is unmistakably a constant of a type;
  # `align::top_left` could have been a member of a variable called `align`.
  # raylib's own types are PascalCase too, so ours sit next to Texture2D and
  # Vector2 without looking foreign — the namespace is what says whose is whose.
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TypeTemplateParameterCase
    value: CamelCase

  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE

  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  # The access rule: a leading underscore on a METHOD means "the framework calls
  # this", and only the eight hooks wear it. Legal as a member (reserved only
  # at global scope). Any other _method fails here, so a private field never
  # takes a hook's name and a helper never looks like one.
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^_(ready|update|late_update|draw|collision|end|suspend|resume)$'

  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  # A private or protected member carries a LEADING underscore, so that a
  # constructor can take `slot` and assign it to `_slot` without either
  # shadowing the other. It never touches a dot: another object's private
  # field is reached through a method that says what is taken
  # (tools/naming_check.sh R3 and R4, which see the uses this cannot).
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: '_'
  # File-scope mutable state is plain snake_case. In src/ and tests/ it is
  # grouped, one struct per concern (`context.started`), so the dot says "file
  # state" at every use and a group cannot collide with a function, a C library
  # name or a parameter. -Wshadow, below, catches a local that hides one.
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case

  # Constants are CONSTANT_CASE, with no prefix: every constexpr, and a const at
  # namespace, class or static scope. A runtime `const float half = w / 2;` in a
  # function is a variable that does not change, and stays snake_case -- which
  # is why LocalConstant is deliberately not set. A constant must not take the
  # name of somebody else's macro (PI, MIN, MAX): tools/naming_check.sh R6.
  - key: readability-identifier-naming.ConstexprVariableCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ClassConstantCase
    value: UPPER_CASE

  # Every macro we define is RMP_: the preprocessor has one namespace, shared
  # with raylib, the C library and the game. tools/naming_check.sh says the
  # same over every #if branch, which this only sees one of.
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: 'RMP_'

  # The style guide's options. A class whose copy is deleted is not asked for
  # its moves (they are deleted with it); a lone `= default` destructor is not
  # a resource being managed; and a class whose copy the language has already
  # deleted -- a scene of a test, derived from rmp::Scene, which is not
  # copyable -- would only repeat it.
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted
    value: true
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: cppcoreguidelines-special-member-functions.AllowImplicitlyDeletedCopyOrMove
    value: true
  # The macros that cannot be a function, by name, and why:
  #   RMP_GAME, RMP_ENTRY_POINT        code generated at file scope: main(), or
  #   RMP_DESKTOP_FUNCS, RMP_WEB_FUNCS the platform's entry points
  #   RMP_IOS_FUNCS
  #   RMP_REPORT_ONCE(_KEYED)          the call site: one static per expansion
  #   RMP_COMPILER_ADDRESS,            `#if`: what the compiler says about its
  #   RMP_COMPILER_UNDEFINED           own sanitizers (tests/sanitize_test.cpp)
  # The .toml's values are -D or generated/config.h, which this never reads.
  - key: cppcoreguidelines-macro-usage.AllowedRegexp
    value: '^RMP_(GAME|ENTRY_POINT|DESKTOP_FUNCS|WEB_FUNCS|IOS_FUNCS|REPORT_ONCE|REPORT_ONCE_KEYED|COMPILER_ADDRESS|COMPILER_UNDEFINED)$'
