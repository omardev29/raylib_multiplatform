<?xml version="1.0" encoding="utf-8"?>
<!-- #doc -->
<!--
  TEMPLATE. tools/configure.py turns this into raymob/app/generated/AndroidManifest.xml,
  which is what Gradle actually reads (see sourceSets in app/build.gradle). The
  generated copy is never committed, so it cannot drift out of sync with
  raylib_multiplatform.toml.

  Two kinds of substitution happen, and they are not the same thing:

    ${NAME}                 a Gradle manifestPlaceholder — a *value* inside an
                            attribute, substituted by AGP at merge time.

    <!-- #if flag --> ...   a whole-element condition, resolved HERE, because
    <!-- #endif -->         AGP has no way to drop an element based on a
                            property. Flags come from the toml: internet,
                            vibration, admob.

  The second one exists because of a real bug: `android:required` is only an
  attribute of <uses-feature>, never of <uses-permission>. Writing
  `<uses-permission android:required="false">` is silently ignored, so
  `internet = false` used to ship an APK that asked for INTERNET anyway.
-->
<!-- #enddoc -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="${GL_VERSION_CODE}" android:required="true" />

    <!-- Permissions: asked for or not asked for. There is no middle setting. -->

    <!-- #if internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- #endif -->

    <!-- #if vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- #endif -->

    <!-- #if admob -->
    <!-- Required by the Google Mobile Ads SDK on Android 13+ (API 33+). It is
         also what obliges you to declare "advertising ID" in Play's Data safety
         form, which is why [android.admob] enabled = false removes it. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- #endif -->

    <!-- Hardware. required="true" makes the Play Store hide the app from
         devices without it; required="false" declares it as optional. -->

    <uses-feature android:name="android.hardware.sensor.gyroscope"
        android:required="${REQUIRE_GYROSCOPE}" />

    <uses-feature android:name="android.hardware.sensor.accelerometer"
        android:required="${REQUIRE_ACCELEROMETER}" />

    <!-- Application config -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appCategory="${APP_CATEGORY}"
        tools:targetApi="31">

        <!-- #if admob -->
        <!-- AdMob application id (set via [android.admob] app_id in raylib_multiplatform.toml) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />
        <!-- #endif -->

        <activity
            android:name=".NativeLoader"
            android:configChanges="keyboardHidden|screenSize"
            android:screenOrientation="${APP_ORIENTATION}" android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:clearTaskOnLaunch="true"
            android:exported="true">
            <!-- MAIN + LAUNCHER, and neither is configurable, because this pair
                 is what puts an icon in the app drawer. It used to read
                 android.intent.category.${APP_CATEGORY}, so setting
                 [android] category = "GAME" produced an APK that installed
                 perfectly and then appeared nowhere on the device: an intent
                 category is not an app category. The app category is
                 android:appCategory on <application>, above. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="${APP_LIB_NAME}" />
        </activity>

    </application>

</manifest>
