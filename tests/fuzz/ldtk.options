# libFuzzer flags for fuzz_ldtk, one a line: tools/fuzz.sh run and merge pass them.
# A seed is one level of a project, cut to what the reader reads (the samples
# of tests/fixtures/ldtk/ are 300-400 KB): 16 KB holds the largest, and keeps
# the merged corpus small (tests/campaign_test.py holds the whole corpus under 2 MB).
-max_len=16384
