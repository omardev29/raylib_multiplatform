# libFuzzer's dictionary for fuzz_e2e_script: the grammar's words, so a
# mutation can write a line the parser reads past its first word. tools/fuzz.sh
# hands it to libFuzzer as -dict when it exists.
newline="\x0a"
comment="#"
press=" press "
release=" release "
tap=" tap "
click=" click "
shot=" shot "
expect=" expect scene "
end=" end"
key_space="KEY_SPACE"
key_enter="KEY_ENTER"
key_kp_enter="KEY_KP_ENTER"
pad="GAMEPAD_BUTTON_RIGHT_FACE_DOWN"
max_frame="36000"
past_max="36001"
nine_digits="999999999"
ten_digits="9999999999"
scope="::"
anonymous="(anonymous namespace)"
global="_GLOBAL__N_1"
nested_open="N"
nested_close="E"
msvc_class="class "
msvc_struct="struct "
msvc_anonymous="`anonymous namespace'"
